{
  "name": "taraz-accounting",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "format": "prettier --write src tests next.config.ts package.json tsconfig.json",
    "db:setup": "node scripts/local-db.mjs setup",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run seed --prefix backend",
    "backend:dev": "npm run dev --prefix backend",
    "backend:build": "npm run build --prefix backend",
    "backend:test": "node scripts/test-backend.mjs",
    "db:demo": "node backend/node_modules/tsx/dist/cli.mjs backend/src/seed-demo.ts",
    "local:start": "node scripts/local-app.mjs start",
    "local:stop": "node scripts/local-app.mjs stop",
    "local:status": "node scripts/local-app.mjs status",
    "local:setup": "npm run db:setup && npm install --prefix backend && npm run db:migrate --prefix backend && npm run db:generate --prefix backend && npm run seed --prefix backend && npm run build --prefix backend",
    "test:backend": "node scripts/test-backend.mjs",
    "test:full": "node scripts/test-backend.mjs --browser",
    "db:backup": "node scripts/backup.mjs create",
    "db:restore": "node scripts/backup.mjs restore"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "exceljs": "4.4.0",
    "jalaali-js": "2.0.1",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/jalaali-js": "1.2.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
