{$DOMAIN:ranjbar.dev} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    @api path /api /api/*
    handle @api {
        reverse_proxy backend:4000
    }
    handle {
        reverse_proxy frontend:3000
    }
}
